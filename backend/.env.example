NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# CORS: origens permitidas separadas por virgula
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=savordelli
DB_POOL_LIMIT=10

# Segredos. Gerar cada um com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ENCRYPTION_KEY deve ter exatamente 64 caracteres hex (32 bytes).
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30
ENCRYPTION_KEY=
HMAC_KEY=
